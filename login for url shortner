// ── App ───────────────────────────────────────────────────────────────────────
export default function App() {
  const [user, setUser] = useState(null);
  const [toast, setToast] = useState(null);
  const [urls, setUrls] = useState(DB);

  function showToast(msg) {
    setToast(msg);
    setTimeout(() => setToast(null), 2200);
  }

  return (
    <>
      <style>{css}</style>
      <div className="app">
        <Nav user={user} onLogout={() => setUser(null)} />
        {!user
          ? <AuthPage onAuth={setUser} />
          : <Dashboard user={user} urls={urls} setUrls={setUrls} showToast={showToast} />
        }
      </div>
      {toast && <div className="toast">✓ {toast}</div>}
    </>
  );
}

// ── Nav ───────────────────────────────────────────────────────────────────────
function Nav({ user, onLogout }) {
  return (
    <nav className="nav">
      <div className="logo">snip<span>.</span>ly</div>
      {user && (
        <div className="nav-right">
          <span className="chip">{user}</span>
          <button className="btn btn-ghost btn-sm" onClick={onLogout}>Log out</button>
        </div>
      )}
    </nav>
  );
}

// ── Auth ──────────────────────────────────────────────────────────────────────
function AuthPage({ onAuth }) {
  const [tab, setTab] = useState("login");
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [err, setErr] = useState("");

  function handleSubmit() {
    setErr("");
    if (!username.trim() || !password.trim()) { setErr("All fields are required."); return; }
    if (tab === "login") {
      if (USERS[username] === password) { onAuth(username); }
      else setErr("Invalid username or password.");
    } else {
      if (USERS[username]) { setErr("Username already taken."); return; }
      USERS[username] = password;
      onAuth(username);
    }
  }

  return (
    <div className="auth-wrap">
      <div className="auth-card">
        <div className="auth-title">Welcome back</div>
        <div className="auth-sub">Short URLs, big impact.</div>
        <div className="tabs">
          <div className={`tab${tab === "login" ? " active" : ""}`} onClick={() => setTab("login")}>Log in</div>
          <div className={`tab${tab === "register" ? " active" : ""}`} onClick={() => setTab("register")}>Register</div>
        </div>
        <div className="field">
          <label className="label">Username</label>
          <input className="input mono" value={username} onChange={e => setUsername(e.target.value)}
            placeholder="alice" onKeyDown={e => e.key === "Enter" && handleSubmit()} />
        </div>
        <div className="field">
          <label className="label">Password</label>
          <input className="input" type="password" value={password} onChange={e => setPassword(e.target.value)}
            placeholder="••••••••" onKeyDown={e => e.key === "Enter" && handleSubmit()} />
        </div>
        {err && <div className="error-msg">{err}</div>}
        <button className="btn btn-primary" style={{ width: "100%", marginTop: 20, justifyContent: "center" }}
          onClick={handleSubmit}>
          {tab === "login" ? "Log in →" : "Create account →"}
        </button>
        <div style={{ marginTop: 16, fontSize: ".78rem", color: "var(--muted)", textAlign: "center" }}>
          Demo: alice / password
        </div>
      </div>
    </div>
  );
}

// ── Dashboard ─────────────────────────────────────────────────────────────────
function Dashboard({ user, urls, setUrls, showToast }) {
  const [longUrl, setLongUrl] = useState("");
  const [createErr, setCreateErr] = useState("");
  const [editTarget, setEditTarget] = useState(null);

  const myUrls = urls.filter(u => u.userId === user);
  const totalClicks = myUrls.reduce((s, u) => s + u.clicks, 0);

  function handleCreate() {
    setCreateErr("");
    if (!longUrl.trim()) { setCreateErr("Please enter a URL."); return; }
    if (!isValidUrl(longUrl.trim())) { setCreateErr("Enter a valid URL (include https://)."); return; }
    const entry = { id: nextId++, userId: user, key: generateKey(), longUrl: longUrl.trim(), clicks: 0, createdAt: Date.now() };
    const next = [entry, ...urls];
    DB = next; setUrls(next); setLongUrl("");
    showToast("Short URL created!");
  }

  function handleDelete(id) {
    const next = urls.filter(u => u.id !== id);
    DB = next; setUrls(next);
    showToast("Deleted.");
  }

  function handleEdit(updated) {
    const next = urls.map(u => u.id === updated.id ? updated : u);
    DB = next; setUrls(next); setEditTarget(null);
    showToast("URL updated!");
  }

  function handleCopy(key) {
    const short = `snip.ly/${key}`;
    navigator.clipboard?.writeText(short).catch(() => {});
    showToast(`Copied ${short}`);
  }

  function simulateClick(id) {
    const next = urls.map(u => u.id === id ? { ...u, clicks: u.clicks + 1 } : u);
    DB = next; setUrls(next);
  }

  return (
    <div className="dashboard">
      {/* header */}
      <div className="page-header">
        <div>
          <div className="page-title">Your Links</div>
          <div className="page-sub">Manage and track all your short URLs</div>
        </div>
      </div>

      {/* stats */}
      <div className="stats-row">
        <div className="stat-card">
          <div className="stat-label">Total Links</div>
          <div className="stat-val purple">{myUrls.length}</div>
        </div>
        <div className="stat-card">
          <div className="stat-label">Total Clicks</div>
          <div className="stat-val teal">{totalClicks}</div>
        </div>
        <div className="stat-card">
          <div className="stat-label">Avg Clicks</div>
          <div className="stat-val red">{myUrls.length ? (totalClicks / myUrls.length).toFixed(1) : 0}</div>
        </div>
      </div>

      {/* create */}
      <div className="create-panel">
        <div className="create-title">✦ Shorten a new URL</div>
        <div className="create-row">
          <input className="input" value={longUrl} onChange={e => setLongUrl(e.target.value)}
            placeholder="https://your-very-long-url.com/goes/here"
            onKeyDown={e => e.key === "Enter" && handleCreate()} />
          <button className="btn btn-primary" onClick={handleCreate}>Shorten →</button>
        </div>
        {createErr && <div className="error-msg" style={{ marginTop: 8 }}>{createErr}</div>}
      </div>

      {/* table */}
      {myUrls.length === 0 ? (
        <div className="empty">
          <div className="empty-icon">🔗</div>
          <div>No short URLs yet — create your first one above!</div>
        </div>
      ) : (
        <div className="table-wrap">
          <div className="table-head">
            <span>Short URL</span>
            <span>Destination</span>
            <span>Clicks</span>
            <span>Created</span>
            <span>Actions</span>
          </div>
          {myUrls.map(url => (
            <div className="url-row" key={url.id}>
              <div className="short-key">
                <span>snip.ly/{url.key}</span>
                <button title="Copy" style={{ background: "none", border: "none", cursor: "pointer", color: "var(--muted)", fontSize: ".8rem" }}
                  onClick={() => handleCopy(url.key)}>⎘</button>
              </div>
              <div className="long-url" title={url.longUrl}>{url.longUrl}</div>
              <div>
                <span className="click-badge" title="Simulate a click" onClick={() => simulateClick(url.id)} style={{ cursor: "pointer" }}>
                  ↗ {url.clicks}
                </span>
              </div>
              <div className="date-text">{fmtDate(url.createdAt)}</div>
              <div className="actions">
                <button className="btn btn-ghost btn-sm" onClick={() => setEditTarget(url)}>Edit</button>
                <button className="btn btn-danger" onClick={() => handleDelete(url.id)}>Delete</button>
              </div>
            </div>
          ))}
        </div>
      )}

      {editTarget && (
        <EditModal url={editTarget} onSave={handleEdit} onClose={() => setEditTarget(null)} />
      )}
    </div>
  );
}

// ── EditModal ─────────────────────────────────────────────────────────────────
function EditModal({ url, onSave, onClose }) {
  const [longUrl, setLongUrl] = useState(url.longUrl);
  const [key, setKey] = useState(url.key);
  const [err, setErr] = useState("");

  function handleSave() {
    setErr("");
    if (!isValidUrl(longUrl.trim())) { setErr("Enter a valid URL."); return; }
    if (!key.trim()) { setErr("Short key cannot be empty."); return; }
    onSave({ ...url, longUrl: longUrl.trim(), key: key.trim() });
  }

  return (
    <div className="modal-backdrop" onClick={e => e.target === e.currentTarget && onClose()}>
      <div className="modal">
        <div className="modal-title">Edit Short URL</div>
        <div className="field">
          <label className="label">Short Key</label>
          <input className="input mono" value={key} onChange={e => setKey(e.target.value)} />
        </div>
        <div className="field">
          <label className="label">Destination URL</label>
          <input className="input" value={longUrl} onChange={e => setLongUrl(e.target.value)} />
        </div>
        {err && <div className="error-msg">{err}</div>}
        <div className="modal-actions">
          <button className="btn btn-ghost" onClick={onClose}>Cancel</button>
          <button className="btn btn-primary" onClick={handleSave}>Save changes</button>
        </div>
      </div>
    </div>
  );
}
